# Spectra HUD — configuração
# Copie para .env e preencha. NUNCA comite o .env.

# Obrigatório: chave do provedor (endpoint compatível com OpenAI Chat Completions).
SPECTRA_API_KEY=

# Opcional: base URL do provedor (sem barra no final).
SPECTRA_BASE_URL=https://opencode.ai/zen/go/v1

# Opcional: modelo com suporte a imagem.
SPECTRA_MODEL=deepseek-v4-flash-vision-exp

# Opcional: atalhos globais (sintaxe do pynput).
# Ctrl+Space conflita com autocomplete de IDEs; prefira <ctrl>+<alt>+<space>.
SPECTRA_HOTKEY=<ctrl>+<space>
SPECTRA_HOTKEY_BAR=<ctrl>+<shift>+<space>
