# Spectra HUD — configuração via ambiente (opcional)
# O caminho normal é o Centro de Comando (Ctrl+Alt+C), que grava
# ~/.config/spectra-hud/config.yaml (e o config.json de compatibilidade) e a chave no system keyring.
# Use este arquivo para CI/headless ou como override. NUNCA comite o .env.

# Opcional no uso normal: o centro de comando guarda a chave no system keyring.
# Use este arquivo para CI/headless ou como override.
# Para CI/headless: chave do provedor (endpoint compatível com OpenAI Chat Completions).
SPECTRA_API_KEY=

# Base e modelo dependem do provedor. Exemplos:
#
# OpenCode Go (requer assinatura):
#   SPECTRA_BASE_URL=https://opencode.ai/zen/go/v1
#   SPECTRA_MODEL=deepseek-v4.1-flash
#
# OpenCode Zen (modelo free, quando a cota permite):
#   SPECTRA_BASE_URL=https://opencode.ai/zen/v1
#   SPECTRA_MODEL=deepseek-v4.1-flash-free
#
# CommandCode:
#   SPECTRA_BASE_URL=https://api.commandcode.ai/provider/v1
#   SPECTRA_MODEL=deepseek/deepseek-v4.1-flash

SPECTRA_BASE_URL=https://opencode.ai/zen/go/v1
SPECTRA_MODEL=deepseek-v4.1-flash

# Atalhos (sintaxe do pynput). Ctrl+Space conflita com autocomplete de IDEs.
SPECTRA_HOTKEY=<ctrl>+<alt>+<space>
SPECTRA_HOTKEY_BAR=<ctrl>+<shift>+<space>
